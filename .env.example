# Set a unique password of at least 12 characters before starting Visora.
VISORA_ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=3001

# Project API keys are encrypted for later viewing/copying by the administrator.
# Optional 32-byte master key as 64 hex characters. Use the same value on all app instances.
VISORA_ENCRYPTION_KEY=
# With no explicit master key, Visora creates this private file. Keep it with your backups.
VISORA_ENCRYPTION_KEY_FILE=./data/encryption.key

# SQLite is the default; a nonempty DATABASE_URL takes precedence over this path.
VISORA_DATABASE=./data/visora.sqlite
VISORA_DATABASE_URL=
# Use a database and account dedicated to Visora. These are placeholders, not local services.
# VISORA_DATABASE_URL=postgres://visora:CHANGE_ME@visora-db:5432/visora
# VISORA_DATABASE_URL=mysql://visora:CHANGE_ME@visora-db:3306/visora
VISORA_DB_SSL=false
# Optional CA certificate file (path inside the container when using Docker).
VISORA_DB_CA_FILE=
# Unset/empty: SQLite migrates automatically; PostgreSQL/MySQL require pnpm db:migrate.
# Set false after schema provisioning when running multiple app instances.
# VISORA_AUTO_MIGRATE=false

VISORA_RETENTION_DAYS=90
# Per-minute, per-IP limits; browser collection additionally partitions by site ID.
VISORA_RATE_LIMIT=1000
VISORA_BROWSER_RATE_LIMIT=120
VISORA_SERVER_RATE_LIMIT=300
VISORA_LOGIN_RATE_LIMIT=5
# Set to true only behind a trusted reverse proxy. Restrict direct access to Visora.
# Enable only behind a controlled proxy that overwrites forwarded headers, with direct access blocked.
# This controls visitor IP attribution as well as rate limiting.
VISORA_TRUST_PROXY=false
# Set to true when serving over HTTPS (including via a reverse proxy).
VISORA_SECURE_COOKIE=false
