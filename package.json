{
  "name": "visora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --dir front build",
    "start": "node --env-file-if-exists=.env server/src/index.mjs",
    "test": "node --test server/test/*.test.mjs",
    "test:e2e": "pnpm --dir front exec playwright test",
    "lint": "pnpm --dir front lint",
    "db:migrate": "node --env-file-if-exists=.env server/src/cli/migrate.mjs"
  }
}
